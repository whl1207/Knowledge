        </mxCell>
        <mxCell id="t146" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#3D4E62;fontSize=11;fontStyle=0;align=left;verticalAlign=top;" value="&lt;b&gt;Local-first:&lt;/b&gt; config, chats, knowledge bases and logs all live on this machine; only model requests go to the sources you configure.&lt;br&gt;&lt;b&gt;Unified registry:&lt;/b&gt; tools, MCP and plugin tools share one registry;&lt;br&gt;every entry point (chat / workflow / batch / web) uses the same rules.&lt;br&gt;&lt;b&gt;One model config, reused everywhere:&lt;/b&gt;&lt;br&gt;chat, knowledge base, workflow and learning share the source and model;&lt;br&gt;sources are grouped as local / cloud / custom gateway.&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(61, 78, 98), rgb(159, 174, 191));&quot;&gt;Plugins are first-class:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;A plugin is a folder + manifest: it can add tools and register main panels / settings tabs / settings cards / global hotkeys; permissions must be declared (fs / shell / net / agent / llm / image), and the UI half shares the host realm but cannot reach a global IPC bridge; drop it into the plugins folder and it works — the built-in dev guide + builtin-plugin-dev let a model write plugins for you.&lt;/div&gt;" vertex="1">
          <mxGeometry height="266" width="312" x="1337" y="607" as="geometry" />
        </mxCell>
        <mxCell id="c159" parent="1" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#10233B;fontSize=16;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=4;" value="" vertex="1">
