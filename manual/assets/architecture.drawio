        <mxCell id="t145" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#10233B;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" value="Architecture notes" vertex="1">
