<mxCell id="c393" value="中国机构" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;fontStyle=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="60" height="22" as="geometry"/></mxCell>
<mxCell id="c394" value="非中国机构" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="120" y="140" width="80" height="22" as="geometry"/></mxCell>
<mxCell id="c395" value="结论反直觉：在工科门类里中国机构的相对影响力反而更高 —— 机械·运载·力学 0.57 vs 0.47、能源·材料·化工 0.48 vs 0.42、土木建筑 0.38 vs 0.31；&#xa;经济与管理是唯一明显更低的门类（0.30 vs 0.40），其余基本持平。&#xa;所以“全局 CN 0.42 &lt; US 0.61”的差距不能简单读成“中国学者在同学科内表现更差”——它与学科构成、职业阶段、会议选择都有关，需要按门类拆开看。" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="508" width="881" height="64" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
</mxfile>