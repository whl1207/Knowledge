{
  "name": "knowledge",
  "version": "6.10.19",
  "main": "dist-electron/main/index.js",
  "description": "AI Knowledge management Software",
  "author": "whl",
  "homepage": "https://github.com/whl1207/Knowledge",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "private": true,
  "keywords": [
    "AI",
    "Knowledge",
    "management",
    "workflow"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start-app.mjs",
    "build": "vue-tsc --noEmit && vite build && electron-builder --dir && node scripts/rename-unpacked.mjs",
    "build:web": "vue-tsc --noEmit && vite build",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run build:web && cap sync android && cd android && gradlew.bat assembleDebug",
    "build:dist": "vue-tsc --noEmit && vite build && electron-builder && node scripts/rename-unpacked.mjs",
    "build-portable": "vue-tsc --noEmit && vite build && electron-builder --win portable && node scripts/rename-unpacked.mjs",
    "build-linux": "vue-tsc --noEmit && vite build && electron-builder --linux",
    "release:win": "vue-tsc --noEmit && vite build && electron-builder --win portable && node scripts/rename-unpacked.mjs && node scripts/collect-release.mjs",
    "release:win-setup": "vue-tsc --noEmit && vite build && electron-builder --win nsis portable && node scripts/rename-unpacked.mjs && node scripts/collect-release.mjs",
    "release:linux": "scripts\\build-linux-all.cmd && node scripts/collect-release.mjs",
    "release:all": "npm run release:win && npm run release:linux",
    "release:collect": "node scripts/collect-release.mjs",
    "preview": "vite preview",
    "office:fetch": "node scripts/fetch-office-vendor.mjs --mirror",
    "office:build": "node scripts/build-office.mjs --editors docs,sheets,slides",
    "office:build:docs": "node scripts/build-office.mjs --editors docs",
    "office:build:native": "node scripts/build-office.mjs --native-only --with-sheets-native",
    "test:plugin-smoke": "node scripts/plugin-smoke/run.mjs",
    "test:selftest": "node scripts/run-selftests.mjs",
    "check:plugin-migration": "node scripts/check-plugin-api-migration.mjs"
  },
  "build": {
    "appId": "com.whl.aikm",
    "productName": "AI-KM",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-*/**",
      "node_modules/sherpa-onnx-linux-*/**",
      "node_modules/sherpa-onnx-darwin-*/**",
      "node_modules/node-pty/**",
      "dist-electron/main/tts-worker.js",
      "dist/maps/**"
    ],
    "files": [
      "dist",
      "dist-electron",
      "!node_modules/@capacitor/**/build/**"
    ],
    "extraResources": [
      {
        "from": "resources/office",
        "to": "office"
      },
      {
        "from": "resources/native",
        "to": "native"
      },
      {
        "from": "resources/file-icons",
        "to": "file-icons"
      }
    ],
    "compression": "maximum",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png",
      "artifactName": "${productName}_v${version}_Setup.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "kb"
          ],
          "name": "AI-KM Knowledge Base",
          "description": "AI-KM Knowledge Base",
          "role": "Editor"
        },
        {
          "ext": [
            "md",
            "markdown",
            "mdown",
            "mkd"
          ],
          "name": "Markdown Document",
          "description": "Markdown Document",
          "role": "Editor"
        },
        {
          "ext": [
            "txt",
            "log"
          ],
          "name": "Plain Text Document",
          "description": "Plain Text Document",
          "role": "Editor"
        },
        {
          "ext": [
            "json",
            "jsonc"
          ],
          "name": "JSON Document",
          "description": "JSON Document",
          "role": "Editor"
        },
        {
          "ext": [
            "html",
            "htm"
          ],
          "name": "HTML Document",
          "description": "HTML Document",
          "role": "Editor"
        },
        {
          "ext": [
            "css",
            "scss",
            "less"
          ],
          "name": "Stylesheet",
          "description": "Stylesheet",
          "role": "Editor"
        },
        {
          "ext": [
            "xml"
          ],
          "name": "XML Document",
          "description": "XML Document",
          "role": "Editor"
        },
        {
          "ext": [
            "yaml",
            "yml"
          ],
          "name": "YAML Document",
          "description": "YAML Document",
          "role": "Editor"
        },
        {
          "ext": [
            "toml"
          ],
          "name": "TOML Document",
          "description": "TOML Document",
          "role": "Editor"
        },
        {
          "ext": [
            "csv"
          ],
          "name": "CSV Document",
          "description": "CSV Document",
          "role": "Editor"
        },
        {
          "ext": [
            "ts",
            "tsx",
            "vue"
          ],
          "name": "TypeScript Source File",
          "description": "TypeScript / Vue Source File",
          "role": "Editor"
        },
        {
          "ext": [
            "java",
            "c",
            "h",
            "cpp",
            "hpp",
            "cs",
            "go",
            "rs",
            "sql"
          ],
          "name": "Source Code File",
          "description": "Source Code File",
          "role": "Editor"
        },
        {
          "ext": [
            "excalidraw"
          ],
          "name": "Excalidraw Drawing",
          "description": "Excalidraw Whiteboard Drawing",
          "role": "Editor"
        },
        {
          "ext": [
            "drawio",
            "dio"
          ],
          "name": "draw.io Diagram",
          "description": "draw.io Diagram",
          "role": "Editor"
        },
        {
          "ext": [
            "flow",
            "workflow"
          ],
          "name": "AI-KM Workflow",
          "description": "AI-KM Workflow Diagram",
          "role": "Editor"
        },
        {
          "ext": [
            "data"
          ],
          "name": "AI-KM Data Canvas",
          "description": "AI-KM Data Canvas",
          "role": "Editor"
        },
        {
          "ext": [
            "mmd",
            "mermaid"
          ],
          "name": "Mermaid Diagram",
          "description": "Mermaid Diagram Source File",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}_v${version}_Portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Utility",
      "maintainer": "whl",
      "artifactName": "${productName}-Linux-${version}-${arch}.${ext}",
      "mimeTypes": [
        "text/markdown",
        "text/plain",
        "application/json",
        "text/html",
        "text/css",
        "application/xml",
        "application/x-yaml",
        "application/toml",
        "text/csv"
      ],
      "fileAssociations": [
        {
          "ext": "kb",
          "name": "AI-KM Knowledge Base",
          "description": "AI-KM Knowledge Base",
          "mimeType": "application/x-aikm-kb"
        },
        {
          "ext": "excalidraw",
          "name": "Excalidraw Drawing",
          "description": "Excalidraw Whiteboard Drawing",
          "mimeType": "application/x-excalidraw"
        }
      ]
    },
    "mac": {
      "icon": "build/icons/512x512.png",
      "category": "public.app-category.productivity",
      "artifactName": "AI-KM_Mac_${version}_${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": ["kb"],
          "name": "AI-KM Knowledge Base",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["md", "markdown", "mdown", "mkd"],
          "name": "Markdown Document",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["txt", "log"],
          "name": "Plain Text Document",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["json", "jsonc"],
          "name": "JSON Document",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["html", "htm"],
          "name": "HTML Document",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["css", "scss", "less"],
          "name": "Stylesheet",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["xml"],
          "name": "XML Document",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["yaml", "yml"],
          "name": "YAML Document",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["toml"],
          "name": "TOML Document",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["csv"],
          "name": "CSV Document",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["ts", "tsx", "vue"],
          "name": "TypeScript Source File",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["java", "c", "h", "cpp", "hpp", "cs", "go", "rs", "sql"],
          "name": "Source Code File",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["excalidraw"],
          "name": "Excalidraw Drawing",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["drawio", "dio"],
          "name": "draw.io Diagram",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["flow", "workflow"],
          "name": "AI-KM Workflow",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["data"],
          "name": "AI-KM Data Canvas",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["mmd", "mermaid"],
          "name": "Mermaid Diagram",
          "role": "Editor",
          "rank": "Alternate"
        }
      ]
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^42.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "vite": "^7.3.7",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue": "^3.4.21",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@excalidraw/excalidraw": "^0.17.6",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.12",
    "@types/markdown-it": "^14.1.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3": "^7.9.0",
    "draggable": "^4.2.0",
    "element-plus": "^2.8.0",
    "highlight.js": "^11.10.0",
    "jsplumb": "^2.15.6",
    "katex": "^0.16.47",
    "leaflet": "^1.9.4",
    "localforage": "^1.10.0",
    "mammoth": "^1.8.0",
    "markdown-it": "^14.1.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-mathjax3": "^4.3.2",
    "markdown-it-toc-and-anchor": "^4.2.0",
    "markmap-html-parser": "0.17.0",
    "markmap-lib": "^0.17.0",
    "markmap-view": "^0.17.0",
    "mermaid": "^11.16.0",
    "ml-matrix": "^6.12.1",
    "monaco-editor": "^0.50.0",
    "node-pty": "^1.1.0",
    "ollama": "^0.6.3",
    "onnxruntime-web": "^1.27.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.0",
    "pinia": "^2.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sherpa-onnx-node": "^1.13.8",
    "sql.js": "^1.14.2",
    "tsne-js": "^1.0.3",
    "turndown": "^7.2.0",
    "typescript": "^5.6.3",
    "umap-js": "^1.4.0",
    "vue-pdf-embed": "^2.1.3",
    "vuedraggable": "^4.1.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  }
}
